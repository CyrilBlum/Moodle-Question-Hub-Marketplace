NODE_ENV=development
HOST=127.0.0.1
PORT=8090
PUBLIC_BASE_URL=http://127.0.0.1:8090

# Database Configuration (Dialect: sqlite or mariadb)
DB_DIALECT=sqlite
DB_SQLITE_PATH=./data/marketplace.sqlite

# Production MariaDB Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=questionhub
DB_USER=questionhub
DB_PASSWORD=

# Storage Directory
STORAGE_ROOT=./storage/packages

# Security
JWT_SECRET=super-secret-jwt-key-must-be-at-least-32-chars-long!
JWT_EXPIRES_IN=30d

# Feature Flags
MONETISATION_ENABLED=false

# Rate Limiting
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
