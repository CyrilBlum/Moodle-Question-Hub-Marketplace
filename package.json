{
  "name": "moodle-question-hub-marketplace",
  "version": "1.0.0",
  "description": "Moodle Question Hub Community Marketplace Backend & Web Application",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json && mkdir -p dist/server/taxonomy && cp src/taxonomy/taxonomy.seed.json dist/server/taxonomy/",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/database/migrate.ts",
    "seed": "tsx src/database/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^7.2.4",
    "@fastify/multipart": "^8.1.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/sensible": "^5.5.0",
    "@fastify/static": "^6.12.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^4.3.5",
    "fastify": "^4.26.2",
    "fastify-plugin": "^4.5.1",
    "isomorphic-dompurify": "^4.5.0",
    "knex": "^3.1.0",
    "mysql2": "^3.9.2",
    "nodemailer": "^10.1.1",
    "pino": "^8.19.0",
    "semver": "^7.6.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/semver": "^7.5.8",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "dompurify": "^3.0.9",
    "katex": "^0.16.9",
    "lucide-react": "^0.358.0",
    "pino-pretty": "^10.3.1",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2",
    "vite": "^5.1.6",
    "vitest": "^1.4.0"
  }
}
