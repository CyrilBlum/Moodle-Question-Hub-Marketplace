    <answer fraction="-50" format="html"><text><![CDATA[<p>Einsatz eines Katalysators</p>]]></text></answer>
    <answer fraction="-50" format="html"><text><![CDATA[<p>Konzentrationsaenderung der Edukte</p>]]></text></answer>
